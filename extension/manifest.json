{
  "manifest_version": 3,
  "name": "AlphaApple Solver",
  "version": "1.0",
  "description": "FruitBox game solver using DQN",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://en.gamesaien.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://en.gamesaien.com/*"],
      "js": ["onnxruntime.min.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "model.onnx",
        "ort-wasm.wasm",
        "ort-wasm-simd.wasm",
        "ort-wasm-simd-threaded.jsep.mjs",
        "ort-wasm-simd-threaded.jsep.wasm"
      ],
      "matches": ["https://en.gamesaien.com/*"]
    }
  ]
}
