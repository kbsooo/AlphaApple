{
  "manifest_version": 3,
  "name": "AlphaApple - AI Game Assistant", 
  "version": "1.0.1",
  "description": "AI-powered assistant for FruitBox puzzle games with CreateJS detection",
  
  "permissions": [
    "activeTab"
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["models/*", "libs/*", "*.js"],
      "matches": ["*://*/*"]
    }
  ],
  
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "libs/ort-web.min.js",
        "fruitbox_ai.js", 
        "content_script.js"
      ],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AlphaApple AI Assistant"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png", 
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}